# Optional runtime configuration. VoxClutch currently uses anonymous, read-only public Twitch chat.
# No OAuth credentials or channel-action scopes are required.
PORT=5050
# VOXCLUTCH_DATA_DIR=/path/to/private/data-folder
# Remote preview is disabled by default. For a temporary managed preview only:
# VOXCLUTCH_ALLOW_REMOTE=1
# VOXCLUTCH_PREVIEW_USER=tester
# VOXCLUTCH_PREVIEW_PASSWORD=generate-a-long-random-secret
